# Copy to .env and set real values. Never commit .env.
AYUR_ENVIRONMENT=development            # production refuses to start with dev secrets
AYUR_DATABASE_URL=sqlite:///ayurnidaan.db   # production: Neon Postgres connection string
AYUR_JWT_SECRET=replace-with-64-random-chars
AYUR_PII_SALT=replace-with-a-long-random-secret
AYUR_CORS_ORIGINS=["http://localhost:8081"]
AYUR_BOOTSTRAP_ADMIN_EMAIL=you@example.com  # first account with this email becomes admin
# Analytics API only: when set, every /v1 analytics route requires X-API-Key
AYUR_API_KEY=
# For `ayur fetch` (Kaggle API credentials)
KAGGLE_USERNAME=
KAGGLE_KEY=
